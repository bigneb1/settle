VITE_MAGIC_PUBLISHABLE_KEY=pk_live_...
VITE_CHARGE_REGISTRY_ADDR=
VITE_SCHEDULE_ENGINE_ADDR=
VITE_PAYOUT_ROUTER_ADDR=
VITE_LIQUIDITY_POOL_ADDR=
VITE_DEFAULT_HANDLER_ADDR=
VITE_DCA_PLAN_ADDR=
VITE_USDC_ADDRESS=0xaf88d065e77c8cC2239327C5EDb3A432268e5831

# ── Supabase (public reads via anon key: catalog, merchant payouts, sweep history) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Particle Network (Universal Accounts, EIP-7702 mode) ───────────────
# Create a project at https://dashboard.particle.network — these are the
# same PROJECT_ID/CLIENT_KEY/APP_ID values used by the backend's PARTICLE_*
# vars, just exposed to the browser build.
VITE_PARTICLE_PROJECT_ID=
VITE_PARTICLE_CLIENT_KEY=
VITE_PARTICLE_APP_ID=

# Destination chain for UA cross-chain payments. Particle's exported CHAIN_ID
# enum lists only mainnet chains; Arbitrum One (42161) is the supported destination.
VITE_UA_DESTINATION_CHAIN_ID=42161

# ── Backend API (for POST /api/payments/confirm after a UA payment) ────
# Base URL of the deployed backend/ Vercel project. Empty = same-origin.
VITE_API_URL=

# REQUIRED - a dedicated Arbitrum One RPC endpoint (Alchemy/Infura/QuickNode/
# etc). This is also the RPC node Magic's login flow bootstraps its
# custom-network config against (see frontend/src/lib/magic.ts). There is no
# public-endpoint fallback - the shared arb1.arbitrum.io/rpc endpoint is
# unreliable under load (confirmed directly via repeated eth_call failures)
# and the app throws a clear error at startup if this is unset rather than
# silently degrading to it.
VITE_ARBITRUM_RPC_URL=

# ── Identity & Credit Profile: OAuth client IDs (public, not secret — the
# client_secret stays backend-only, see backend/.env.example) ──────────
VITE_GITHUB_CLIENT_ID=
VITE_GITLAB_CLIENT_ID=
