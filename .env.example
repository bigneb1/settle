# ── Arbitrum RPC ──────────────────────────────────────────────────────
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# ── Contract Addresses (filled after forge deploy) ────────────────────
CHARGE_REGISTRY_ADDR=
SCHEDULE_ENGINE_ADDR=
PAYOUT_ROUTER_ADDR=
LIQUIDITY_POOL_ADDR=
DEFAULT_HANDLER_ADDR=
DCA_PLAN_ADDR=

# ── Token ─────────────────────────────────────────────────────────────
USDC_ADDRESS=0xaf88d065e77c8cC2239327C5EDb3A432268e5831

# ── Wallets ───────────────────────────────────────────────────────────
PRIVATE_KEY=0x                          # deployer
DEPLOYER_ADDRESS=0x
PROTOCOL_TREASURY=0x
SWEEP_AGENT_ADDRESS=0x
SWEEP_AGENT_PRIVATE_KEY=0x              # separate key — sweep authority only

# ── Verification ──────────────────────────────────────────────────────
ARBISCAN_API_KEY=

# ── Particle Network (Universal Accounts, EIP-7702 mode) ───────────────
# Same values also go in frontend/.env.example as VITE_PARTICLE_PROJECT_ID etc.
# Used server-side here for the cross-chain credit signal (particleBalances.js);
# the buyer-facing UA transactions themselves run client-side in the browser.
PARTICLE_PROJECT_ID=
PARTICLE_CLIENT_KEY=
PARTICLE_APP_ID=

# ── Magic Labs ────────────────────────────────────────────────────────
MAGIC_PUBLISHABLE_KEY=
MAGIC_SECRET_KEY=

# ── Supabase ──────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=              # dashboard → Project Settings → API — never a VITE_* var

# ── GLM / Zhipu BigModel (borderline BNPL underwriting explanations) ────
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4.6

# ── Vercel Cron ───────────────────────────────────────────────────────
CRON_SECRET=                            # random secret for cron auth

# ── Frontend (Vite) ───────────────────────────────────────────────────
VITE_CHARGE_REGISTRY_ADDR=
VITE_SCHEDULE_ENGINE_ADDR=
VITE_PAYOUT_ROUTER_ADDR=
VITE_LIQUIDITY_POOL_ADDR=
VITE_DEFAULT_HANDLER_ADDR=
VITE_DCA_PLAN_ADDR=
VITE_USDC_ADDRESS=0xaf88d065e77c8cC2239327C5EDb3A432268e5831
VITE_MAGIC_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Subscription risk gate ────────────────────────────────────────────
SUBSCRIPTION_RISK_THRESHOLD_USD=50
