# ── Arbitrum RPC ──────────────────────────────────────────────────────
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# ── Contract Addresses (fill in after forge deploy) ────────────────────
CHARGE_REGISTRY_ADDR=
SCHEDULE_ENGINE_ADDR=
PAYOUT_ROUTER_ADDR=
LIQUIDITY_POOL_ADDR=
DEFAULT_HANDLER_ADDR=
DCA_PLAN_ADDR=

# ── Token ─────────────────────────────────────────────────────────────
USDC_ADDRESS=0xaf88d065e77c8cC2239327C5EDb3A432268e5831

# ── Sweep agent wallet (separate key from the deployer — see README) ──
SWEEP_AGENT_ADDRESS=
SWEEP_AGENT_PRIVATE_KEY=

# ── Deployer / contract owner (only address ChargeRegistry.createCharge() accepts) ──
PRIVATE_KEY=0x

# ── Supabase ──────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=              # dashboard → Project Settings → API

# ── Particle Network (cross-chain credit signal) ────────────────────────
PARTICLE_PROJECT_ID=
PARTICLE_CLIENT_KEY=
PARTICLE_APP_ID=

# ── GLM / Zhipu BigModel (borderline BNPL underwriting explanations) ────
# OpenAI-compatible endpoint. Get an API key at https://open.bigmodel.cn.
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4.6

# ── Vercel Cron ───────────────────────────────────────────────────────
CRON_SECRET=

# ── Subscription risk gate ────────────────────────────────────────────
SUBSCRIPTION_RISK_THRESHOLD_USD=50

# ── Identity & Credit Profile ────────────────────────────────────────────
# Base URL of the deployed frontend/ Vercel project — used to build OAuth
# callback redirects (e.g. https://settle.app/profile?connected=github).
FRONTEND_URL=

# GitHub OAuth App — register at https://github.com/settings/applications/new
# (instant, self-serve). Authorization callback URL must be exactly
# <backend URL>/api/profile/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitLab OAuth App — register at https://gitlab.com/-/user_settings/applications
# (instant, self-serve). Redirect URI must be exactly
# <backend URL>/api/profile/gitlab/callback. Scope needed: read_user.
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# ── Wallet reputation (ENS resolution) ──────────────────────────────────
# Optional — defaults to a public keyless RPC (ethereum-rpc.publicnode.com).
# Override if you hit rate limits at scale.
ETH_MAINNET_RPC_URL=

# Exchange credentials are NOT set here — each user supplies their own
# read-only API key/secret via the Profile page UI, encrypted at rest via
# Supabase Vault. See supabase/migrations/011_credit_profile_schema.sql.
